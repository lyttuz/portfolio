{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/servir.mjs 4340",
      "url": ["http://localhost:4340/portfolio/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "saida/lighthouse"
    }
  }
}
