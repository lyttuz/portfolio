{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "build:sentry-teste": "node scripts/build-sentry-teste.mjs",
    "servir": "node scripts/servir.mjs",
    "trava:repo": "node scripts/trava.mjs repo",
    "trava:dist": "node scripts/trava.mjs dist",
    "segredos:repo": "secretlint \"**/*\"",
    "segredos:dist": "secretlint --no-gitignore \"dist/**/*\"",
    "pdf": "node scripts/gerar-pdf.mjs",
    "teste": "vitest run",
    "teste:cobertura": "vitest run --coverage",
    "teste:build": "vitest run --config vitest.build.config.ts",
    "e2e": "playwright test",
    "lint": "biome check .",
    "lint:corrigir": "biome check --write .",
    "tipos": "astro check",
    "mutacao": "stryker run",
    "lighthouse": "lhci autorun",
    "auditoria": "npm audit --omit=dev --audit-level=high",
    "tudo": "npm run trava:repo && npm run segredos:repo && npm run lint && npm run tipos && npm run teste:cobertura && npm run build && npm run trava:dist && npm run pdf && npm run segredos:dist && npm run build:sentry-teste && npm run teste:build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sentry/browser": "^11.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@stryker-mutator/core": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "^1.63.0",
    "secretlint": "^13.0.7",
    "simple-icons": "^16.34.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
