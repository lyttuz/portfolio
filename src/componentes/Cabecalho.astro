---
import { perfil } from '../conteudo/perfil'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
// No papel não há clique: o PDF mostra o endereço do LinkedIn no lugar do rótulo.
const linkedinNoPapel = perfil.linkedin.replace(/^https?:\/\/(www\.)?/, '')
const pilula = 'foco rounded-full border px-4 py-2 transition-[color,background-color,border-color,text-decoration-color] duration-150 hover:border-borda-forte hover:bg-superficie-2 hover:text-texto'
---
<header id="topo" class="pt-28 pb-16 sm:pt-36 sm:pb-20 print:pt-0 print:pb-8">
  <p class="font-mono text-xs tracking-widest text-apagado uppercase">{perfil.local}</p>
  <h1 data-anima="titulo" class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-7xl print:text-6xl">{perfil.nome}</h1>
  <p class="mt-4 text-xl text-suave sm:text-2xl">{perfil.titulo}</p>
  <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-suave text-pretty sm:text-xl">{perfil.chamada}</p>
  <nav class="mt-10 flex flex-wrap gap-3 text-sm print:mt-6" aria-label="Contato">
    <a class={`${pilula} border-borda-forte`} href={`mailto:${perfil.email}`}>{perfil.email}</a>
    <a class={`${pilula} border-borda text-suave`} href={perfil.linkedin} rel="noopener noreferrer"><span class="print:hidden">LinkedIn</span><span class="hidden print:inline">{linkedinNoPapel}</span></a>
    <a data-pdf class={`so-tela ${pilula} border-borda text-suave`} href={`${base}gabriel-alves-portfolio.pdf`} download>Baixar PDF</a>
  </nav>
</header>
